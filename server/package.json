{
  "name": "festari-backend",
  "version": "1.0.0",
  "description": "Backend for Festari Estates Online",
  "type": "commonjs",
  "scripts": {
    "copy:templates": "cpx \"src/app/templates/**/*\" dist/app/templates",
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file=.env.development --import tsx\" src/server.ts",
    "dev:staging": "tsx --watch --env-file .env.staging src/server.ts",
    "dev:prod": "tsx --watch --env-file .env src/server.ts",
    "start": "node dist/server.js",
    "build": "npm install --include=dev && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run copy:templates",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check",
    "docker:build": "docker build -t festari-backend .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx --env-file=.env.development src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.development src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:run:all": "drizzle-kit generate && drizzle-kit migrate && tsx --env-file=.env.development src/db/migrate.ts && drizzle-kit push",
    "db:introspect": "drizzle-kit introspect"
  },
  "imports": {
    "#*": "./src/*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "homepage": "https://github.com/festarigroup/FESTARI_estate_online#readme",
  "bugs": {
    "url": "https://github.com/festarigroup/FESTARI_estate_online/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festarigroup/FESTARI_estate_online.git"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.8",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "postgres": "^3.4.9",
    "resend": "^6.18.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.15",
    "cpx": "^1.2.1",
    "eslint": "^10.2.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}

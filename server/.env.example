PORT=3030
NODE_ENV=production|development
DATABASE_URL=postgresql://[username]:[password]@[host]:[port]/[database_name]
PASSWORD_SECRET=string
ENCRYPTION_SECRET=string
ACCESS_TOKEN=string
REFRESH_TOKEN=string
API_BASE_URL=http://localhost:3030/api/v1
# Deployed frontend origin, for CORS. Any http(s)://localhost:<port> origin is
# always allowed too, so this only matters in production.
CLIENT_ORIGIN=https://your-frontend.example.com
MNOTIFY_API_KEY=string
MNOTIFY_SENDER_ID=appName
SENDER_EMAIL=string@app.com
PAYMENT_SECRET_KEY=string
PAYMENT_PUBLIC_KEY=string
PAYSTACK_CALLBACK_URL=https://your-api.example.com/api/v1/payments/webhook
SIMULATE_PAYSTACK_TRANSFERS=false
RESEND_API_KEY=re_string
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_MEDIA_BUCKET=media

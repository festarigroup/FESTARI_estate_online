@host = http://localhost:3030
@baseUrl = {{host}}/api/v1/payments
@authToken = REPLACE_WITH_ACCESS_TOKEN

### List my payments
GET {{baseUrl}}
Authorization: Bearer {{authToken}}

### Initiate a payment
# @name initiate
POST {{baseUrl}}/initiate
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "payment_type": "hotel_booking",
  "target_id": "REPLACE_WITH_BOOKING_ID",
  "amount": 2550,
  "metadata": { "note": "3 nights at The Palm Garden Hotel" }
}

### Verify a payment
GET {{baseUrl}}/verify/{{initiate.response.body.data.reference}}
Authorization: Bearer {{authToken}}

### Get a payment by id
GET {{baseUrl}}/REPLACE_WITH_PAYMENT_ID
Authorization: Bearer {{authToken}}

### Paystack webhook (simulated — real calls come from Paystack, signed)
POST {{baseUrl}}/webhook
Content-Type: application/json
X-Paystack-Signature: test-signature

{
  "event": "charge.success",
  "data": {
    "reference": "REPLACE_WITH_REFERENCE",
    "status": "success",
    "amount": 255000,
    "customer": {
      "email": "ama@example.com"
    }
  }
}
